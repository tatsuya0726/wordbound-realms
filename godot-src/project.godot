; Godot prototype of ごちゃまぜモンスター. Data and art are synced from the web version by tools/sync-from-web.cjs.

config_version=5

[application]

config/name="ごちゃまぜモンスター Godot試作"
config/description="HD-2D English-learning RPG prototype (village + party battle)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.03, 0.05, 0.08, 1)
boot_splash/show_image=false

[audio]

general/text_to_speech=true

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.03, 0.05, 0.08, 1)
